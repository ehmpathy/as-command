// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`npm trusted publisher (integration) given: [case1] the repo at HEAD when: [t0] the trusted-publisher facts are derived from its files then: the facts match the snapshot 1`] = `
{
  "anchors": {
    "callerCount": 1,
    "callerNeeds": [
      "test",
    ],
    "callerTags": [
      "v*",
    ],
    "idTokenWrite": {
      "caller": "write",
      "publishJob": "write",
    },
    "idempotifyIf": "steps.publish.outcome == 'failure'",
    "publishContinueOnError": true,
    "publishStepOrder": [
      "verify oidc auth",
      "verify oidc compat",
      "build",
      "publish",
      "idempotify",
    ],
  },
  "record": {
    "environment": null,
    "organization": "ehmpathy",
    "repository": "as-command",
    "workflowFilename": "publish.yml",
  },
  "runtime": {
    "nodeVersion": "v22.21.0",
  },
}
`;

exports[`npm trusted publisher (integration) given: [case2] a repo where two workflows call the reusable publish when: [t0] the trusted-publisher facts are derived then: the message lists both callers and names which to keep, per the snapshot 1`] = `
"✋ ConstraintError: more than one workflow calls the reusable publish; the npm trusted-publisher record names one caller file

{
  "reusableWorkflow": "./.github/workflows/.publish-npm.yml",
  "callers": [
    "publish.yml",
    "publish2.yml"
  ],
  "hint": "keep the caller whose filename matches the npm record's Workflow filename on npmjs.com; remove the others"
}"
`;

exports[`npm trusted publisher (integration) given: [case3] a repo where no workflow calls the reusable publish when: [t0] the trusted-publisher facts are derived then: the message says to restore the caller, per the snapshot 1`] = `
